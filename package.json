{
    "name": "anisaku",
    "version": "1.0.0",
    "description": "脚本・作画・声優・音楽を集めて作品を公開するカードゲーム",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "build": "tsc --noEmit && vite build",
