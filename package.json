        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@solidjs/router": "^0.15.2",
        "express": "^4.21.2",
        "qrcode": "^1.5.4",
        "solid-js": "^1.9.3",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.2",
        "@types/qrcode": "^1.5.5",
        "@types/ws": "^8.5.13",
        "@vitest/coverage-v8": "^2.1.8",
        "autoprefixer": "^10.4.20",
        "jsdom": "^25.0.1",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vite-plugin-pwa": "^0.21.1",
        "vite-plugin-solid": "^2.11.0",
        "vitest": "^2.1.8"
